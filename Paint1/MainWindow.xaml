<Window x:Class="Paint1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Paint1"
        mc:Ignorable="d"
        Title="Paint" Height="850" Width="1200"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="360"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="20" Height="10"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Width="200" Background="LightGray" Margin="10">
            <TextBlock Text="Файл:" FontWeight="Bold" Margin="5"/>
            <StackPanel Orientation="Vertical" Margin="5">
                <Button x:Name="NewButton" Content="Новый" Margin="0,2" Click="NewButton_Click"/>
                <Button x:Name="OpenButton" Content="Открыть SVG" Margin="0,2" Click="OpenButton_Click"/>
                <Button x:Name="SaveButton" Content="Сохранить SVG" Margin="0,2" Click="SaveButton_Click"/>
            </StackPanel>

            <TextBlock Text="Инструменты:" FontWeight="Bold" Margin="5,15,5,0"/>
            <Button x:Name="LineButton" Content="Линия" Margin="5,2,5,2"/>
            <Button x:Name="SquareButton" Content="Прямоугольник" Margin="5,2,5,2"/>
            <Button x:Name="EllipseButton" Content="Эллипс" Margin="5,2,5,2"/>
            <Button x:Name="PolygonButton" Content="Многоугольник" Margin="5,2,5,2"/>

            <TextBlock Text="Масштаб:" FontWeight="Bold" Margin="5,15,5,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock x:Name="ZoomTextBlock" Text="100%" VerticalAlignment="Center" 
                           Width="60" TextAlignment="Center" FontWeight="Bold" FontSize="14"/>
            </StackPanel>

            <Button x:Name="ZoomResetButton" Content="Сбросить масштаб" Margin="5,0,5,5" Height="25"/>

            <TextBlock Text="Ползунок масштаба:" FontWeight="Bold" Margin="5,10,5,0"/>
            <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="2.0" Value="1.0" 
                    Margin="5,0,5,15" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

            <TextBlock Text="Цвета:" FontWeight="Bold" Margin="5,10,5,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="StrokePreview" Grid.Column="0" Width="40" Height="40" 
                           Fill="Black" Stroke="Black" StrokeThickness="2" Margin="5"/>
                <Rectangle x:Name="FillPreview" Grid.Column="1" Width="40" Height="40" 
                           Fill="White" Stroke="Black" StrokeThickness="2" Margin="5"/>
                <Slider x:Name="HueSlider" Grid.Column="3" Style="{StaticResource HueSliderStyle}" 
                        Height="150" ValueChanged="HueSlider_ValueChanged"/>
            </Grid>

            <TextBlock Text="Квадрат тона:" FontWeight="Bold" Margin="5,10,5,5"/>
            <Canvas x:Name="SVSquare" Width="160" Height="160" Margin="5" Background="Transparent" 
                    MouseLeftButtonDown="SVSquare_MouseLeftButtonDown" 
                    MouseMove="SVSquare_MouseMove" 
                    MouseLeftButtonUp="SVSquare_MouseLeftButtonUp">
                <Rectangle x:Name="SVMarker" Width="10" Height="10" Fill="Black" 
                           Opacity="0.8" Stroke="White" StrokeThickness="1"/>
            </Canvas>

        </StackPanel>

        <Border Grid.Column="1" Background="#F0F0F0">
            <ScrollViewer x:Name="MainScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#F0F0F0"
                          PreviewMouseWheel="Canvas_MouseWheel">
                <Canvas x:Name="Canvas1" Background="White" 
                        MouseRightButtonDown="Canvas_MouseRightButtonDown"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>